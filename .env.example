# Copie para .env (na raiz do projeto) e preencha. O .env nunca vai para o banco nem para o git.

# ---- Postgres (docker compose sobe na porta 5433) ----
AGENTS_PG=Host=localhost;Port=5433;Username=agents;Password=agents;Database=agents

# ---- Azure Foundry / Azure OpenAI (provedor padrao dos agentes) ----
# Endpoint compativel com OpenAI (v1). Exemplos:
#   https://<seu-recurso>.openai.azure.com/openai/v1
#   https://<seu-recurso>.services.ai.azure.com/openai/v1
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
# Nome do DEPLOYMENT no Foundry (ex.: gpt-4.1, gpt-5-mini) - precisa suportar tool calling
AZURE_FOUNDRY_DEPLOYMENT=

# ---- Anthropic (opcional; use: update agents set model_id='claude_default' ...) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ---- Foundry Local / Ollama (opcional) ----
FOUNDRY_LOCAL_ENDPOINT=http://localhost:5273/v1
FOUNDRY_LOCAL_MODEL=

# ---- Busca na web (ferramenta web_search): usa o primeiro configurado ----
# SearXNG self-hosted (ideal on-prem): docker compose --profile search up -d
# SEARXNG_URL=http://localhost:8888
# Brave Search API (https://brave.com/search/api/)
# BRAVE_API_KEY=
# Sem nenhum dos dois: DuckDuckGo Lite (sem chave, bom para desenvolvimento; pode limitar por excesso de uso)

# ---- Human-in-the-loop: prazo para uma pessoa responder um pedido (horas); vencido, vira 'expired' ----
# HITL_EXPIRES_HOURS=24

# ---- Execucao duravel: posse de um run em execucao (lease) e renovacao (heartbeat), em segundos ----
# Sem renovacao ate o lease vencer, o run vira orfao e outra instancia o recupera.
# RUN_LEASE_SECONDS=60
# RUN_HEARTBEAT_SECONDS=20

# ---- Aprovacao de ferramentas com politica 'approval': auto | deny | ask ----
# (os comandos 'task' e 'chat' usam 'ask' por padrao; 'demo' usa 'auto'; o chat web sempre pergunta na tela)
# APPROVAL_MODE=auto
